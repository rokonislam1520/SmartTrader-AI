# Binance API credentials (use testnet keys for development)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Optional Telegram notifications (leave blank to disable safely)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Use the Binance test network by default
BINANCE_TESTNET=true

# Comma-separated trading symbols
TRADING_PAIRS=BTCUSDT,ETHUSDT

# Risk and trading limits
MAX_RISK_PER_TRADE=2
DAILY_LOSS_LIMIT=5
MAX_POSITIONS=3
TRADE_INTERVAL=900

# Optional risk-management settings (defaults are defined in settings.py)
MAX_DRAWDOWN=10.0
STOP_LOSS_ATR_MULTIPLIER=1.5
MIN_RISK_REWARD_RATIO=2.0
